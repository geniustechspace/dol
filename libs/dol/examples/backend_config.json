{
  "_comment": "DOL Unified Configuration Example (JSON). Shows all backend types with multi-instance support.",

  "sql": {
    "dialect": "postgresql",
    "primary": {
      "url": "postgres://user:pass@primary:5432/mydb",
      "pool": {
        "max_connections": 20,
        "min_connections": 5,
        "acquire_timeout_secs": 30,
        "idle_timeout_secs": 600,
        "max_lifetime_secs": 1800
      },
      "tls": {
        "enabled": true,
        "ca_cert_path": "/etc/ssl/certs/rds-ca.pem"
      }
    },
    "replicas": [
      {
        "name": "replica-east",
        "url": "postgres://user:pass@replica-east:5432/mydb",
        "pool": { "max_connections": 30 }
      }
    ],
    "instances": {
      "analytics": {
        "url": "postgres://analytics:pass@analytics-host/analytics_db",
        "pool": { "max_connections": 50 }
      }
    },
    "migrations": {
      "auto_run": true,
      "directory": "migrations"
    },
    "logging": {
      "log_queries": false,
      "log_slow_queries": true,
      "slow_query_threshold_ms": 100
    }
  },

  "kv": {
    "provider": "Redis",
    "primary": {
      "url": "redis://localhost:6379",
      "pool": { "max_connections": 10 }
    },
    "replicas": [
      {
        "name": "redis-replica-1",
        "url": "redis://replica-1:6379"
      }
    ],
    "instances": {
      "sessions": {
        "url": "redis://sessions-host:6379",
        "pool": { "max_connections": 50 }
      }
    },
    "key_prefix": "app:",
    "default_ttl_secs": 3600,
    "redis": {
      "database": 0,
      "cluster": false
    }
  },

  "storage": {
    "provider": "S3",
    "primary": {
      "bucket": "my-app-assets",
      "region": "us-east-1"
    },
    "replicas": [
      {
        "name": "eu-replica",
        "bucket": "my-app-assets-eu",
        "region": "eu-west-1"
      }
    ],
    "instances": {
      "backups": {
        "bucket": "my-app-backups",
        "region": "us-west-2"
      }
    },
    "s3": {
      "storage_class": "STANDARD"
    }
  }
}
